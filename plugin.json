{
  "id": "solidcraft-gears",
  "name": "Gears",
  "version": "0.6.1",
  "description": "Involute spur gear and rack generator with adjustable addendum and dedendum. Each part is built in its own component, with its pitch circle or pitch line as construction geometry at mid-thickness.",
  "capabilities": [
    "commands@0.1"
  ],
  "runtime": {
    "module": "plugin.wasm",
    "entries": [
      {
        "name": "gears",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "required": [
            "name",
            "module",
            "teeth",
            "face_width",
            "pressure_angle",
            "addendum",
            "dedendum"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Name",
              "description": "Name of the component and body",
              "default": "Gear"
            },
            "module": {
              "type": "number",
              "title": "Module",
              "description": "Module m. Pitch diameter = module x teeth",
              "default": 2,
              "minimum": 0.1,
              "maximum": 100,
              "unit": "mm"
            },
            "teeth": {
              "type": "integer",
              "title": "Teeth",
              "description": "Number of teeth",
              "default": 20,
              "minimum": 8,
              "maximum": 80
            },
            "face_width": {
              "type": "number",
              "title": "Face width",
              "description": "Gear thickness",
              "default": 10,
              "minimum": 0.1,
              "maximum": 1000,
              "unit": "mm"
            },
            "pressure_angle": {
              "type": "number",
              "title": "Pressure angle",
              "description": "Pressure angle of the tooth flanks",
              "default": 20,
              "minimum": 10,
              "maximum": 30,
              "unit": "°"
            },
            "bore_diameter": {
              "type": "number",
              "title": "Bore diameter",
              "description": "Centre hole diameter, 0 for none",
              "default": 0,
              "minimum": 0,
              "maximum": 1000,
              "unit": "mm"
            },
            "profile_shift": {
              "type": "number",
              "title": "Profile shift",
              "description": "Profile shift coefficient x; outer diameter = module x (teeth + 2 + 2x)",
              "default": 0,
              "minimum": -1,
              "maximum": 1
            },
            "addendum": {
              "type": "number",
              "title": "Addendum (x module)",
              "description": "Tooth height above the pitch circle as a multiple of the module. 1 is standard",
              "default": 1,
              "minimum": 0.3,
              "maximum": 2
            },
            "dedendum": {
              "type": "number",
              "title": "Dedendum (x module)",
              "description": "Tooth depth below the pitch circle as a multiple of the module. 1.25 is standard",
              "default": 1.25,
              "minimum": 0.3,
              "maximum": 2.5
            }
          }
        },
        "slots": [
          {
            "kind": "menu",
            "name": "Gears"
          }
        ]
      },
      {
        "name": "racks",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "required": [
            "name",
            "module",
            "teeth",
            "pressure_angle",
            "face_width",
            "addendum",
            "dedendum",
            "body_height"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Name",
              "description": "Name of the component and body",
              "default": "Rack"
            },
            "module": {
              "type": "number",
              "title": "Module",
              "description": "Module m. Circular pitch = pi x module",
              "default": 2,
              "minimum": 0.1,
              "maximum": 100,
              "unit": "mm"
            },
            "teeth": {
              "type": "integer",
              "title": "Teeth",
              "description": "Number of teeth; length = teeth x pi x module",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            },
            "pressure_angle": {
              "type": "number",
              "title": "Pressure angle",
              "description": "Pressure angle of the tooth flanks",
              "default": 20,
              "minimum": 10,
              "maximum": 30,
              "unit": "°"
            },
            "face_width": {
              "type": "number",
              "title": "Face width",
              "description": "Rack thickness",
              "default": 10,
              "minimum": 0.1,
              "maximum": 1000,
              "unit": "mm"
            },
            "body_height": {
              "type": "number",
              "title": "Body height",
              "description": "Rack only. Material below the root line",
              "default": 6,
              "minimum": 0.1,
              "maximum": 1000,
              "unit": "mm"
            },
            "addendum": {
              "type": "number",
              "title": "Addendum (x module)",
              "description": "Tooth height above the pitch line as a multiple of the module. 1 is standard",
              "default": 1,
              "minimum": 0.3,
              "maximum": 2
            },
            "dedendum": {
              "type": "number",
              "title": "Dedendum (x module)",
              "description": "Tooth depth below the pitch line as a multiple of the module. 1.25 is standard",
              "default": 1.25,
              "minimum": 0.3,
              "maximum": 2.5
            }
          }
        },
        "slots": [
          {
            "kind": "menu",
            "name": "Racks"
          }
        ]
      }
    ],
    "commands": [
      "component.activate",
      "component.create",
      "sketch.arc.three_point",
      "sketch.circle.center",
      "sketch.create",
      "sketch.finish",
      "sketch.line",
      "sketch.spline.fit_point",
      "solid.cylinder",
      "solid.extrude",
      "solid.pattern.circular"
    ],
    "limits": {
      "fuel": 200000000,
      "memory_mib": 64,
      "deadline_ms": 30000
    }
  }
}
